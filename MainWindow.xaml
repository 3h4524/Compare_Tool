<Window x:Class="CompareTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare Tool" Height="760" Width="1220" MinHeight="620" MinWidth="900"
        Background="#F4F6F8" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="15,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Padding" Value="12,8,12,12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Padding" Value="8,8"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E5E7EB"/><Setter Property="Foreground" Value="#374151"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172554" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Document Compare" Foreground="White" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="So sánh Old/New, review khác biệt và phân loại file" Foreground="#BFDBFE" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="Word · Aspose optional" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#DBEAFE" FontSize="12"/>
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Header="Folders" Background="White">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Old folder" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBox x:Name="OldFolderBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="BrowseOld_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="New folder" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBox x:Name="NewFolderBox" Grid.Row="1" Grid.Column="1" Margin="0,0,10,8"/>
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseNew_Click"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Output folder" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="OutputFolderBox" Grid.Row="2" Grid.Column="1" Margin="0,0,10,0"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseOutput_Click"/>
            </Grid>
        </GroupBox>

        <Border Grid.Row="2" Background="White" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="Actions" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Compare" Click="Compare_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <Button Content="Move files" Click="Move_Click" Margin="0,0,18,0"/>
                    <TextBlock Text="Filter" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="FilterBox" Width="155" Height="34" SelectionChanged="FilterBox_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="All files" Tag="All"/><ComboBoxItem Content="Matched" Tag="Matched"/>
                        <ComboBoxItem Content="Different" Tag="Different"/><ComboBoxItem Content="Only in Old" Tag="OnlyInOld"/>
                        <ComboBoxItem Content="Only in New" Tag="OnlyInNew"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryText" Foreground="#3730A3" FontWeight="SemiBold" VerticalAlignment="Center" Text="Chưa có kết quả. Chọn hai folder rồi bấm Compare."/>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="7" Padding="8">
            <ListView x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged" BorderThickness="0">
                <ListView.View><GridView>
                    <GridViewColumn Header="File name" DisplayMemberBinding="{Binding FileName}" Width="300"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding StatusText}" Width="130"/>
                    <GridViewColumn Header="Old / New size" DisplayMemberBinding="{Binding SizeText}" Width="180"/>
                    <GridViewColumn Header="Old path" DisplayMemberBinding="{Binding OldPath}" Width="360"/>
                </GridView></ListView.View>
            </ListView>
        </Border>
        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}"/>
    </Grid>
</Window>
